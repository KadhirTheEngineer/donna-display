# The display works in demo mode without these values.
PORT=4173
DISPLAY_NAME=Good evening
LATITUDE=41.8781
LONGITUDE=-87.6298
TIMEZONE=America/Chicago

# Google Cloud OAuth 2.0 Web application credentials.
# Add http://localhost:4173/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Spotify Web API application credentials.
# Add http://localhost:4173/auth/spotify/callback as a redirect URI.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
