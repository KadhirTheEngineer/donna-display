# The display works in demo mode without these values.
PORT=4173
DISPLAY_NAME=Good evening
LATITUDE=30.2672
LONGITUDE=-97.7431
WEATHER_LOCATION=Austin
TIMEZONE=America/Chicago

# Google Cloud OAuth 2.0 Web application credentials.
# Add http://localhost:4173/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Spotify Web API application credentials.
# Spotify requires an explicit loopback IP; localhost is rejected.
# Add http://127.0.0.1:4173/auth/spotify/callback as a redirect URI.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:4173/auth/spotify/callback
